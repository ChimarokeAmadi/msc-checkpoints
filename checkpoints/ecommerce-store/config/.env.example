# Copy this file to config/.env and fill in your own values.
# config/.env is in .gitignore, so your secrets never go to GitHub.
# On Azure, put the same variables in the Web App's "Environment variables" instead.

# MongoDB Atlas connection string (put the database name "ecommerce" before the "?")
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<your-cluster>.mongodb.net/ecommerce?retryWrites=true&w=majority

# A long random string used to sign login tokens. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# The account registered with this email becomes the shop admin
ADMIN_EMAIL=you@example.com

# Optional (Azure sets PORT by itself)
PORT=3000
