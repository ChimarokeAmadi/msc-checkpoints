<%- include('partials/header') %>

<h1 class="page-title">Contact us</h1>

<div class="contact-grid">
  <section>
    <p class="lead">Have a project in mind? Send us a message and we'll reply within one working day.</p>
    <ul class="contact-info">
      <li><strong>Email:</strong> hello@brightway.example</li>
      <li><strong>Phone:</strong> +234 800 000 0000</li>
      <li><strong>Hours:</strong> Monday to Friday, 9:00 to 17:00</li>
    </ul>
  </section>

  <section class="form-box">
    <% if (sent) { %>
      <p class="message success">Thank you, <%= sent %>! We got your message and will get back to you soon.</p>
    <% } %>
    <% if (errors.length > 0) { %>
      <ul class="message error">
        <% errors.forEach((error) => { %><li><%= error %></li><% }) %>
      </ul>
    <% } %>

    <form action="/contact" method="POST">
      <label for="name">Name</label>
      <input id="name" name="name" type="text" value="<%= form.name || '' %>" required>

      <label for="email">Email</label>
      <input id="email" name="email" type="email" value="<%= form.email || '' %>" required>

      <label for="message">Message</label>
      <textarea id="message" name="message" rows="5" required minlength="10"><%= form.message || '' %></textarea>

      <button type="submit" class="button">Send message</button>
    </form>
  </section>
</div>

<%- include('partials/footer') %>
