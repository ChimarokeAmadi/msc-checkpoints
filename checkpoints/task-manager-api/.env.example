# Copy this file to .env and fill it in. Never commit .env or share it.

PORT=3000
NODE_ENV=development

# MongoDB connection string (e.g. from MongoDB Atlas).
# Leave empty in development to use a temporary in-memory database.
MONGO_URI=

# A long random secret used to sign the JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=1

# Set to false ONLY if you test from another device over plain http (not localhost)
COOKIE_SECURE=true

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Leave empty to turn Google login off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
