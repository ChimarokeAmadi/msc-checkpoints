# Copy this file to .env and fill it in. Never commit .env or share it.

# Your Gmail address (the email is sent from and to this address)
EMAIL_USER=your.address@gmail.com

# A Gmail App Password (16 characters), NOT your normal password.
# Create one at https://myaccount.google.com/apppasswords (2-Step Verification must be on)
EMAIL_PASS=abcd efgh ijkl mnop
