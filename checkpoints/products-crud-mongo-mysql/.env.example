# Copy to .env and fill in. Never commit .env.
# Leave the database settings empty to use temporary in-memory databases.

PORT=3000

# MongoDB (local: mongodb://127.0.0.1:27017/shop, or a MongoDB Atlas string)
MONGO_URI=

# MySQL (leave MYSQL_HOST empty to start a temporary MySQL server)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=shop
