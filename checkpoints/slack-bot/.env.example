# Copy this file to .env and fill in your own values.
# Never commit .env or share these tokens.

# OAuth & Permissions -> Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Basic Information -> App-Level Tokens (starts with xapp-), needed for Socket Mode
SLACK_APP_TOKEN=xapp-your-app-token

# Only needed if you use HTTP mode instead of Socket Mode
# (Basic Information -> App Credentials -> Signing Secret)
# SLACK_SIGNING_SECRET=your-signing-secret
# PORT=3000
